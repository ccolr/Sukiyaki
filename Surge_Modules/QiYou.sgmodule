#!name=Panel - Gasoline Prices
#!desc=Show local gasoline prices
#!category=🌸 Sukiyaki
#!arguments=province:shandong
#!arguments-desc=🔔 Note: for Shanxi province enter shanxi, for Shaanxi province enter shanxi-3

[Panel]
QiYou = script-name=QiYou,update-interval=43200

[Script]
QiYou = type=generic,timeout=5,script-path=https://sukiyaki.cco.moe/Surge_Modules/youjia.js,argument={{{province}}}
