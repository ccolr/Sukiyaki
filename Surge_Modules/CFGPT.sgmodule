#!name=ChatGPT Panel
#!desc=Detect the ChatGPT availability region
#!category=🌸 Sukiyaki
#!author=keywos
# Parameter notes
# Optional parameter "icon=xxx" sets a custom icon; the value is any valid SF Symbol Name, e.g. bolt.horizontal.circle.fill. See the app https://apps.apple.com/cn/app/sf-symbols-browser/id1491161336 for details
# Optional parameter "color=xxx" controls the icon color when the icon field is used; the value is the color's HEX code, e.g. color=#007aff


[Panel]

# GPT
CFGPT = script-name=CFGPT,update-interval=-1
[Script]
CFGPT = type=generic,timeout=6,script-path=https://sukiyaki.cco.moe/Surge_Modules/CFGPT.js,argument=icon=lasso.and.sparkles&icon-color=#000000
