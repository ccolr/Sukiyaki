#!name=VPS Knockd Manual Control
#!desc=Manual open and close controls for one VPS. Each panel sends only its corresponding knockd sequence.
#!category=🌸 Sukiyaki
#!author=otmno
#!arguments=vps_name:VPS-1,vps_host:vps1.example.com,open_ports:7123|8234|9345,close_ports:9345|8234|7123
#!arguments-desc=Configure the VPS name, address, open sequence, and close sequence. Separate ports with | and use no more than 5 ports per sequence.

[Script]
VPS-Knock-Open = type=generic,timeout=10,script-path=https://sukiyaki.cco.moe/Surge_Modules/vps-knock.js,argument="action=open&name={{{vps_name}}}&host={{{vps_host}}}&ports={{{open_ports}}}"
VPS-Knock-Close = type=generic,timeout=10,script-path=https://sukiyaki.cco.moe/Surge_Modules/vps-knock.js,argument="action=close&name={{{vps_name}}}&host={{{vps_host}}}&ports={{{close_ports}}}"

[Panel]
VPS-Knock-Open = title="{{{vps_name}}} Knock Open",content="Target: {{{vps_host}}}\nSequence: {{{open_ports}}}",icon=xserve,script-name=VPS-Knock-Open
VPS-Knock-Close = title="{{{vps_name}}} Knock Close",content="Target: {{{vps_host}}}\nSequence: {{{close_ports}}}",icon=xserve,script-name=VPS-Knock-Close
